# Variables de entorno de incapacidad-ocr. Copia este archivo a `.env` y ajústalo.
#
#   cp .env.example .env
#
# `.env` NO se versiona (lleva credenciales). `docker compose` lo lee solo; si corres la app
# a mano, expórtalas tú. Todos los valores de aquí son los DEFAULTS del código: el archivo
# documenta qué existe, no impone nada.

# ------------------------------------------------------------------ base de datos (ASTGU)
# En el stack de Docker apuntan al contenedor `db`. Para correr la app FUERA de Docker
# contra esa misma BD de prueba: DB_HOST=127.0.0.1 (el puerto se publica en localhost).
# En PRODUCCIÓN estos valores apuntan a la BD ASTGU real que provee el cliente.
DB_HOST=db
DB_PORT=3306
DB_NAME=ASTGU
DB_USER=ocr
DB_PASSWORD=ocr

# ------------------------------------------------------------------------ IA local (opcional)
# El servicio web alcanza Ollama por el nombre de servicio de compose. Los modelos se fijan
# EN EL SERVIDOR a propósito: el cliente de la API no puede elegirlos (anti-SSRF).
OLLAMA_URL=http://ollama:11434
OCR_MODEL=qwen2.5vl:3b
LLM_MODEL=gemma3:4b
OLLAMA_TIMEOUT=900

# ------------------------------------------------------------------------- ingesta por lotes
# Raíz del árbol de carpetas (bind mount ./ingesta:/data/ingesta en el compose).
INGESTA_ROOT=/data/ingesta
# Corrida programada. VACÍO = desactivada. Ej.: "0 2 * * *" = cada día a las 02:00.
INGESTA_CRON=
BATCH_TZ=America/Bogota
INGESTA_EXTRACTOR=rule

# ------------------------------------------------------------------------------ pruebas
# Declara que ESTA base de datos es de PRUEBA: habilita que «Reiniciar prueba» VACÍE la
# tabla de staging. NO poner en producción — es la única salvaguarda que impide vaciar el
# staging de la BD ASTGU real. Sin esta variable el reinicio solo borra las filas
# pendientes de los archivos que se están reiniciando.
RESET_BD_PRUEBA=1

# ------------------------------------------------------------- límites (anti-DoS, opcionales)
# Descomenta solo si hace falta. Ojo: PDF_RENDER_SCALE y OCR_MAX_PIXELS son los que
# determinan la RAM por worker — con los defaults, un escaneo grande llegó a 7,6 GB
# (ver INSTALACION_CLIENTE.md §2).
# MAX_UPLOAD_BYTES=52428800
# MAX_PDF_PAGES=30
# OCR_MAX_PIXELS=40000000
# PDF_RENDER_SCALE=3.0
# VISION_MAX_DIM=1200
